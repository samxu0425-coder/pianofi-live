# The always-on front door (a t4g.nano): HTTPS, the two logins, and a proxy to the GPU
# box over the VPC. When the box is stopped or reclaimed (it is spot), the proxy gets no
# answer and Caddy serves offline.html instead of an error. The login name travels to
# the service as X-User (set here, so a client cannot forge it): the service lets only
# {$AUTH_USER} add songs, and start.py limits a guest's starts of the GPU box.
{$SITE} {
	basic_auth {
		{$AUTH_USER} {$AUTH_HASH}
		{$GUEST_USER} {$GUEST_HASH}
	}
	request_header X-User {http.auth.user.id}
	handle /start {
		reverse_proxy 127.0.0.1:9000
	}
	handle /ws* {
		reverse_proxy {$ENGINE}:8001 {
			transport http {
				dial_timeout 3s
			}
		}
	}
	handle {
		reverse_proxy {$ENGINE}:8000 {
			transport http {
				dial_timeout 3s
			}
		}
	}
	handle_errors {
		@down expression `{err.status_code} in [502, 503, 504]`
		handle @down {
			root * /opt/pianofi/srv
			rewrite * /offline.html
			file_server
		}
	}
	request_body {
		max_size 200MB
	}
}
